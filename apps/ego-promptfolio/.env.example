# Скопируйте в .env и измените значения для production

SECRET_KEY=change-me-to-a-random-secret-key
FLASK_DEBUG=1

# SQLite (по умолчанию instance/app.db)
# DATABASE_URL=sqlite:///instance/app.db

# Учётная запись администратора (создаётся/обновляется при старте)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

LOG_LEVEL=INFO
