# Active chat provider: proxyapi (default) or openai
LLM_PROVIDER=proxyapi

# ProxyAPI chat provider
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=
PROXYAPI_MODEL=

# Direct OpenAI chat provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings can use a separate provider from chat (proxyapi or openai).
# Set EMBEDDING_BASE_URL when the embeddings endpoint differs from the chat endpoint.
EMBEDDING_PROVIDER=proxyapi
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

APP_ENV=development
REQUEST_TIMEOUT=30
SIMILARITY_THRESHOLD=0.45
TOP_K=3
MAX_MESSAGE_LENGTH=4000
CORS_ORIGINS=http://localhost:8000

# Paths can be absolute or relative to the project root.
# DATA_DIR=data
# FAISS_INDEX_PATH=data/faiss.index
# METADATA_PATH=data/metadata.json
# MEMORY_DB_PATH=data/conversations.sqlite3
